#!/usr/bin/python3
import sys
import numpy as np
from PIL import Image
import actfw_core
from actfw_core.task import Pipe, Consumer
from actfw_core.system import find_csi_camera_device, get_actcast_firmware_type
from actfw_core.unicam_isp_capture import UnicamIspCapture
from actfw_raspberrypi.vc4 import Display


# capture image size
(CAPTURE_WIDTH, CAPTURE_HEIGHT) = (320, 240)

# display area size
(DISPLAY_WIDTH, DISPLAY_HEIGHT) = (640, 480)


class Converter(Pipe):
    """Convert RGB camera image to grayscale image"""

    def __init__(self, capture_size):
        super(Converter, self).__init__()
        self.capture_size = capture_size

    def proc(self, frame):
        rgb_image = Image.frombuffer(
            "RGB", self.capture_size, frame.getvalue(), "raw", "RGB"
        )
        gray_image = rgb_image.convert("L")
        return gray_image


class Presenter(Consumer):
    """Display grayscale image on preview window and take photo view"""

    def __init__(self, preview_window, cmd):
        super(Presenter, self).__init__()
        self.preview_window = preview_window
        self.cmd = cmd

    def proc(self, gray_image):
        # update `Take Photo` image
        self.cmd.update_image(gray_image)

        # if preview window is available, display grayscale image
        if self.preview_window is not None:
            # convert grayscale image to RGB image for display in preview window
            gray_image = gray_image.convert("RGB")
            self.preview_window.blit(np.asarray(gray_image).tobytes())
            self.preview_window.update()

        actfw_core.heartbeat()


def run(app, preview_window=None):
    # CommandServer (for `Take Photo` command)
    cmd = actfw_core.CommandServer()
    app.register_task(cmd)

    # register capture task
    capture_size = (CAPTURE_WIDTH, CAPTURE_HEIGHT)
    framerate = 30
    if get_actcast_firmware_type() == "raspberrypi-bookworm":
        import libcamera
        from actfw_core.libcamera_capture import LibcameraCapture, ScalerCrop, SensorConfig
        camera_options = {}
        camera = libcamera.CameraManager.singleton().cameras[0]
        if "imx219" in str(camera.id).lower():
            capture_width, capture_height = capture_size
            sensor_width, sensor_height, scale, offset_x, offset_y = 1640, 1232, 2, 0, 0
            crop_scale = min(sensor_width / capture_width, sensor_height / capture_height)
            crop_width, crop_height = round(capture_width * crop_scale), round(capture_height * crop_scale)
            crop_x, crop_y = int((sensor_width - crop_width) / 2), int((sensor_height - crop_height) / 2)
            # OS3と画角を合わせるため、IMX219のセンサーモードを明示する。
            sensor_config = SensorConfig(bit_depth=10, output_size=(sensor_width, sensor_height))
            camera_options.update(sensor_config=sensor_config, scaler_crop=ScalerCrop(
                x=offset_x + crop_x * scale, y=offset_y + crop_y * scale,
                width=crop_width * scale, height=crop_height * scale))
        else:
            print(f"WARNING: Camera {camera.id!r} is not IMX219; use automatic sensor mode and crop.", file=sys.stderr, flush=True)
        cap = LibcameraCapture(capture_size, libcamera.PixelFormat("BGR888"), framerate=framerate, **camera_options)
    else:
        device = find_csi_camera_device()
        cap = UnicamIspCapture(unicam=device, size=capture_size, framerate=framerate)
    app.register_task(cap)

    # register converter task
    conv = Converter(cap.capture_size())
    app.register_task(conv)

    # register presenter task
    pres = Presenter(preview_window, cmd)
    app.register_task(pres)

    # Make task connection
    cap.connect(conv)  # from `cap` to `conv`
    conv.connect(pres)  # from `conv` to `pres`

    # Start application
    app.run()


def main():
    # Actcast application
    app = actfw_core.Application()

    # Load act setting
    settings = app.get_settings({"display": False})

    if settings["display"]:
        with Display() as display:
            preview_area = (0, 0, DISPLAY_WIDTH, DISPLAY_HEIGHT)
            capture_size = (CAPTURE_WIDTH, CAPTURE_HEIGHT)
            layer = 16
            with display.open_window(
                preview_area, capture_size, layer
            ) as preview_window:
                run(app, preview_window)
    else:
        run(app)


if __name__ == "__main__":
    main()
